# =======================================================
# SmartOP Environment Configuration Template
# Copy this file to .env for local testing or configure
# these environment variables in your cloud hosting dashboard
# (Railway, Render, Fly.io, etc.)
# =======================================================

# Port assigned by cloud provider (Render sets 10000, Railway assigns dynamically)
PORT=8080

# -------------------------------------------------------
# Cloud MySQL Database Option A: Unified Connection URL
# (Railway / Heroku style)
# -------------------------------------------------------
DATABASE_URL=mysql://username:password@mysql.railway.internal:3306/smartop_db

# -------------------------------------------------------
# Cloud MySQL Database Option B: Individual Variables
# (Standard cloud parameters)
# -------------------------------------------------------
DB_HOST=mysql.railway.internal
DB_PORT=3306
DB_NAME=smartop_db
DB_USER=root
DB_PASSWORD=your_cloud_db_password

# -------------------------------------------------------
# Optional Frontend API Base URL
# (Leave blank when frontend & backend are served on the same domain)
# -------------------------------------------------------
SMARTOP_API_BASE_URL=
